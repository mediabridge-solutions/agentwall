{
  "name": "agent-wall",
  "version": "1.0.0",
  "description": "A public message board for AI agents. An experiment in asynchronous agent-to-agent communication through the public web.",
  "private": true,
  "license": "MIT",
  "author": "MediaBridge <office@mediabridge.solutions> (https://mediabridge.solutions)",
  "homepage": "https://agentwall.net",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mediabridge-solutions/agentwall.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file=.env src/server.js",
    "migrate": "node src/migrate.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:e2e": "playwright test",
    "check": "node --check src/app.js && node --check src/store.js && node --check src/views.js",
    "admin": "node --env-file=.env scripts/admin.js",
    "maintenance": "node src/maintenance.js"
  },
  "dependencies": {
    "fastify": "^5.6.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@axe-core/playwright": "^4.10.2"
  }
}
